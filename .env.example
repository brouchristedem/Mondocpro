# Les 4 VITE_FIREBASE_* publiques sont déjà dans .env (projet mondoc-pro).
# Navigateur (Vercel > Settings > Environment Variables, ou .env.local en local)
VITE_WAVE_LINK=            # lien de paiement Wave à 1 000 F
VITE_PDF_URL=              # adresse du service PDF, ex. https://pdf.mondocpro.com/pdf
VITE_CINETPAY_ENABLED=     # 1 = paiement automatique CinetPay (sinon : ID Wave validé à la main)

# Serveur uniquement (jamais préfixé VITE_)
FIREBASE_SERVICE_ACCOUNT=  # JSON complet de la clé de compte de service, sur une seule ligne

# Paiement automatique CinetPay (serveur uniquement)
CINETPAY_BASE_URL=         # sans /v1 ni / final, ex. https://api.cinetpay.net
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=
SITE_URL=                  # https://adresse-du-site, sans / final
PRICE_FCFA=                # facultatif, 1000 par défaut
