rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chacun lit uniquement son propre profil. Aucune écriture depuis le navigateur :
    // le statut « payé » et le 1er document gratuit sont écrits par /api/claim (serveur).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Brouillon synchronisé (texte, réglages, page de garde) : chacun lit et écrit uniquement le sien, avec des limites de taille.
    match /drafts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['text', 's', 'preset', 'docId', 'updatedAt'])
        && request.resource.data.text is string && request.resource.data.text.size() < 600000
        && request.resource.data.s is string && request.resource.data.s.size() < 300000
        && request.resource.data.preset is string && request.resource.data.preset.size() < 20
        && request.resource.data.docId is string && request.resource.data.docId.size() <= 64
        && request.resource.data.updatedAt is number;
    }
    // Documents du compte (synchronisés entre les appareils) : chacun lit et écrit uniquement les siens, avec des limites de taille.
    match /users/{uid}/docs/{id} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'text', 's', 'preset', 'updatedAt', 'deleted'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.text is string && request.resource.data.text.size() < 600000
        && request.resource.data.s is string && request.resource.data.s.size() < 300000
        && request.resource.data.preset is string && request.resource.data.preset.size() < 20
        && request.resource.data.updatedAt is number
        && id.size() <= 64;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
